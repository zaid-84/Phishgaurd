# Ignore virtual environments
env/
venv/

# Python cache
__pycache__/
*.pyc

# Windows executables
*.exe
chromedriver*

# Ignore screenshots / logs
static/screenshots/*

# Git metadata
.git
.gitignore

# OS / editor files
.DS_Store
*.swp
*.bak
Thumbs.db

# Pip cache
pip-cache/

# Keep model files in the image — don't ignore .pkl here
